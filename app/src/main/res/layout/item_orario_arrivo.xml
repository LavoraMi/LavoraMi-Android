<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <View
        android:id="@+id/lineTop"
        android:layout_width="3dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:background="@color/redMetro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/dotOrario" />

    <View
        android:id="@+id/lineBottom"
        android:layout_width="3dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:background="@color/redMetro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dotOrario"
        app:layout_constraintBottom_toBottomOf="parent" />

    <View
        android:id="@+id/dotOrario"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="@drawable/circle_interchange_dot"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtTime"
        app:layout_constraintBottom_toBottomOf="@id/txtTime" />

    <TextView
        android:id="@+id/txtTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/inter"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="14:35"
        app:layout_constraintStart_toEndOf="@id/dotOrario"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtMins"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/font_main"
        android:textColor="@color/subtitle"
        android:textSize="14sp"
        tools:text="in 12 min"
        app:layout_constraintStart_toEndOf="@id/txtTime"
        app:layout_constraintTop_toTopOf="@id/txtTime"
        app:layout_constraintBottom_toBottomOf="@id/txtTime" />

    <TextView
        android:id="@+id/txtHeadsign"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/inter"
        android:textColor="@color/subtitle"
        android:textSize="13sp"
        tools:text="Direzione GESSATE"
        app:layout_constraintStart_toEndOf="@id/dotOrario"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTime"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
