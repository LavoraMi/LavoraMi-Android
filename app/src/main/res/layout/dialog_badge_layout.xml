<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="20dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/dialogBadgeCard"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            app:cardBackgroundColor="@color/disclosureBg"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/dialogBadgeImage"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                tools:src="@drawable/ic_star_fill" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/dialogBadgeName"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/font_main"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Nome Badge" />

        <TextView
            android:id="@+id/dialogBadgeStatus"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:textColor="@color/redMetro"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="SBLOCCATO!" />

        <TextView
            android:id="@+id/dialogBadgeDescription"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:textColor="@color/subtitle"
            android:textSize="14sp"
            tools:text="Descrizione del badge e come sbloccarlo." />

        <LinearLayout
            android:id="@+id/dialogProgressContainer"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/dialogProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:minHeight="0dp"
                android:maxHeight="12dp"
                android:progressDrawable="@drawable/rounded_progress_bar"
                tools:max="10"
                tools:progress="4" />

            <TextView
                android:id="@+id/dialogProgressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter"
                android:textColor="@color/subtitle"
                android:textSize="12sp"
                tools:text="Progresso: 4/10" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close_badge_dialog"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/redMetro"
            android:fontFamily="@font/font_main"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:text="@string/understood"
            android:textAllCaps="false"
            android:textColor="@color/White"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="16dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
